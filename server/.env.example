# Server-only settings. Never copy this file into dist/ or EXPO_PUBLIC_* variables.
PORT=8080
ADMIN_EMAIL=admin@example.com
# Generate with: ADMIN_PASSWORD='a-long-unique-password' bun server/password.js
ADMIN_PASSWORD_HASH=
COOKIE_SECURE=true
# For a separate frontend host, comma-separated origins (no paths).
APP_ORIGINS=http://localhost:8080
# Optional absolute paths on a durable private volume; defaults: server/data/.
# DATA_FILE=/private-volume/state.json
# CLIENT_DB=/private-volume/clients.sqlite
# STATIC_DIR=/path/to/dist
# Only trusted immediate reverse proxies; they must overwrite X-Real-IP.
TRUSTED_PROXY_IPS=
# Existing push is optional. Leave empty to keep it disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
FCM_SERVICE_ACCOUNT_JSON=
