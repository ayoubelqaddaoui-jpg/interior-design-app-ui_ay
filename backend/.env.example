# ---- Laravel ---------------------------------------------------------------------------------------------------------
APP_NAME=Dwira
APP_ENV=production
APP_DEBUG=false
# Generate once with: php artisan key:generate --show   (encrypts stored provider keys; keep it secret and backed up)
APP_KEY=
# Your public site, https, no trailing slash
APP_URL=https://example.com
LOG_CHANNEL=daily
LOG_DAILY_DAYS=7
LOG_LEVEL=warning

# ---- MySQL (hPanel > Databases) --------------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ---- Runtime (shared hosting: file cache, no sessions, no queue worker) -----------------------------------------------
CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# ---- Dwira API --------------------------------------------------------------------------------------------------------
# Admin login. There is NO default account: without both values nobody can sign in to the admin panel.
ADMIN_EMAIL=
# Generate with: php artisan dwira:admin-password   (or `php tools/make-admin-hash.php` on your own computer)
# Keep the single quotes: the hash contains $ characters.
ADMIN_PASSWORD_HASH=
# Extra browser origins allowed to call the API (comma separated). Your own domain needs no entry (same origin).
APP_ORIGINS=
COOKIE_SECURE=true
# Only if the site is behind Cloudflare / a reverse proxy: "*" or a comma separated list of proxy IPs.
TRUSTED_PROXIES=
# Secret for the HTTP cron endpoint GET /api/push/pump (Authorization: Bearer <secret>). Optional with hPanel cron.
CRON_SECRET=
# Seconds the public /api/content may be cached by a CDN (0 disables).
CONTENT_S_MAXAGE=30
API_RATE_LIMIT=300
CHAT_RATE_LIMIT=90

# Web Push keys are generated automatically and stored (encrypted) in the database. Set these only to pin your own.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Optional: native Android notifications (Firebase service-account JSON on ONE line).
FCM_SERVICE_ACCOUNT_JSON=

# Media (stored on this server: storage/app/public/media, served as /api/media/<hash>.<ext>)
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_VIDEO_MB=100
MEDIA_WEBP_QUALITY=82
MEDIA_MAX_DIMENSION=2560

# AI assistant (free tiers). Keys can also be pasted in the admin panel (stored encrypted).
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
