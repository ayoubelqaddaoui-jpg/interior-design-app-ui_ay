# The Laravel application must never be reachable from the web. Normally it sits outside public_html (then this file is
# unused); if it was uploaded inside public_html, this denies every request to it.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
